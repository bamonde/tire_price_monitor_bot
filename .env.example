# URL de busca monitorada
MONITOR_URL=https://shop.example.com/busca?page=1&search=90%2F90-21

# Caminho do histórico (volume Docker: /app/data)
HISTORY_FILE=/app/data/price-history.jsonl

# Retenção do histórico em horas (padrão: 72 = 3 dias)
HISTORY_RETENTION_HOURS=72

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Fuso horário do container
TZ=America/Sao_Paulo
