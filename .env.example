# --- Nitro (pneus) ---
# URL(s) de busca monitorada(s)
# Use MONITOR_URL para uma única busca ou MONITOR_URLS para várias (separadas por vírgula)
MONITOR_URL=https://shop.example.com/busca?page=1&search=90%2F90-21
# MONITOR_URLS=https://shop.example.com/busca?search=90%2F90-21,https://shop.example.com/busca?search=120%2F70-19

# Histórico Nitro (default: /app/data/nitro/price-history.jsonl)
# Caminhos legados (/app/data/price-history.jsonl) continuam válidos se definidos aqui.
HISTORY_FILE=/app/data/nitro/price-history.jsonl

# Retenção do histórico Nitro em horas (padrão: 72 = 3 dias)
HISTORY_RETENTION_HOURS=72

# --- Webmotors (HB20 1.0 TGDI) ---
# Store de IDs já vistos (retenção longa; sem prune de 72h)
WEBMOTORS_SEEN_FILE=/app/data/webmotors/seen.json

# --- Telegram (compartilhado) ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Fuso horário do container
TZ=America/Sao_Paulo
