{
  "name": "pneu-price-monitor",
  "version": "1.0.0",
  "description": "Monitor de preços de pneus (Nitro) e anúncios Webmotors com alertas no Telegram",
  "main": "dist/nitro/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run start:nitro",
    "start:nitro": "node dist/nitro/index.js",
    "start:webmotors": "node dist/webmotors/index.js",
    "dev": "npm run dev:nitro",
    "dev:nitro": "tsx src/nitro/index.ts",
    "dev:webmotors": "tsx src/webmotors/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
